PORT=4000

# MySQL connection. `npm run db:setup` creates DB_NAME if it does not exist.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_eats

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGIN=http://localhost:3000

# Sales tax as a fraction, e.g. 0.08875 for 8.875%. 0 hides the tax line.
TAX_RATE=0

# Passcode for the kitchen screen (/kitchen). Kitchen endpoints stay disabled while empty.
ADMIN_TOKEN=
