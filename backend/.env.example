PORT=4000

# PostgreSQL connection. `npm run db:setup` creates DB_NAME if it does not exist.
# For Supabase use the "Session pooler" values from the Connect dialog:
#   DB_HOST=aws-1-<region>.pooler.supabase.com  DB_PORT=5432
#   DB_USER=postgres.<project-ref>              DB_NAME=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=campus_eats

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# In production add the site's URL, e.g. https://your-site.vercel.app
CORS_ORIGIN=http://localhost:3000

# Sales tax as a fraction, e.g. 0.08875 for 8.875%. 0 hides the tax line.
TAX_RATE=0

# Passcode for the kitchen screen (/kitchen). Kitchen endpoints stay disabled while empty.
ADMIN_TOKEN=
